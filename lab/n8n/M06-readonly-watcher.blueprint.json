{
  "name": "M06 Canonical Synthetic Watcher",
  "nodes": [
    {
      "id": "schedule",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0],
      "parameters": {"rule": {"interval": [{"field": "hours", "hoursInterval": 24}]}}
    },
    {
      "id": "input",
      "name": "M06 Adapter Input",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [240, 0],
      "parameters": {
        "assignments": {
          "assignments": [
            {"id": "adapter", "name": "adapter_url", "value": "http://127.0.0.1:8787", "type": "string"},
            {"id": "fixture", "name": "fixture_json", "value": "{\"version\":\"br13-offer-fixture/v1\",\"method\":\"GET\",\"url\":\"https://example.com/br13/offer\",\"observed_at\":\"2026-09-03T00:00:00Z\",\"correlation_id\":\"event-1\",\"status_code\":200,\"body\":\"{\\\"product_id\\\":\\\"a\\\",\\\"product_name\\\":\\\"Fixture A\\\",\\\"currency\\\":\\\"USD\\\",\\\"price\\\":100,\\\"commission_rate\\\":0.08}\"}", "type": "string"}
          ]
        }
      }
    },
    {
      "id": "handoff",
      "name": "Build and Append Canonical M06 Adapter",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [510, 0],
      "notes": "The shared adapter builds the M00 packet and learner HistoryRecord, appends it, then resolves/replays it before ACK. This workflow never constructs canonical history locally.",
      "parameters": {
        "method": "POST",
        "url": "={{ $('M06 Adapter Input').item.json.adapter_url + '/v1/m06/fixture-import' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {fixture:JSON.parse($('M06 Adapter Input').item.json.fixture_json)} }}",
        "options": {"response": {"response": {"fullResponse": true, "responseFormat": "json"}}}
      }
    },
    {
      "id": "ack",
      "name": "Require Canonical Store ACK",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [780, 0],
      "parameters": {
        "jsCode": "const response=$json.body||$json; const status=response.status; if((status!=='APPENDED'&&status!=='EXACT_DUPLICATE')||response.canonical_history_ack!==true||response.canonical_history_persisted!==true||!response.record_id) throw new Error('CANONICAL_HISTORY_NOT_ACKNOWLEDGED'); return [{json:{...response,canonical_history_handoff:'ACK',execution_permitted:false}}];"
      }
    },
    {
      "id": "report",
      "name": "Report Canonical M06 Result",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1050, 0],
      "parameters": {
        "assignments": {
          "assignments": [
            {"id": "status", "name": "result", "value": "={{ $json.status }}", "type": "string"},
            {"id": "record", "name": "record_id", "value": "={{ $json.record_id }}", "type": "string"},
            {"id": "ack", "name": "canonical_history_handoff", "value": "={{ $json.canonical_history_handoff }}", "type": "string"},
            {"id": "persisted", "name": "canonical_history_persisted", "value": "={{ $json.canonical_history_persisted }}", "type": "boolean"},
            {"id": "execution", "name": "execution_permitted", "value": "={{ $json.execution_permitted }}", "type": "boolean"}
          ]
        }
      }
    }
  ],
  "connections": {
    "Schedule Trigger": {"main": [[{"node": "M06 Adapter Input", "type": "main", "index": 0}]]},
    "M06 Adapter Input": {"main": [[{"node": "Build and Append Canonical M06 Adapter", "type": "main", "index": 0}]]},
    "Build and Append Canonical M06 Adapter": {"main": [[{"node": "Require Canonical Store ACK", "type": "main", "index": 0}]]},
    "Require Canonical Store ACK": {"main": [[{"node": "Report Canonical M06 Result", "type": "main", "index": 0}]]}
  },
  "active": false,
  "settings": {}
}
