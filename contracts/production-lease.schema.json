{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "production-lease.schema.json",
  "title": "ProductionLease",
  "type": "object",
  "required": [
    "lease_id","lease_version","policy_version","approval_ref","reviewed_by","reviewer_id","reviewed_at",
    "promotion_review_ref","source_canary_grant_id","source_canary_grant_version","source_canary_grant_hash",
    "valid_from","expires_at","allowed_risk_classes","allowed_action_types","allowed_hosts","executor_ids",
    "max_executions_total","max_executions_per_window","window_seconds","max_cost_minor_total","currency",
    "max_pending_outcomes","max_consecutive_failures","max_outcome_age_seconds","max_health_snapshot_age_seconds",
    "kill_switch_required","correlation_id","hash_version","lease_hash"
  ],
  "properties": {
    "lease_id":{"type":"string","minLength":1},
    "lease_version":{"type":"string","minLength":1},
    "policy_version":{"type":"string","minLength":1},
    "approval_ref":{"type":"string","minLength":1},
    "reviewed_by":{"const":"human"},
    "reviewer_id":{"type":"string","minLength":1},
    "reviewed_at":{"type":"string","format":"date-time"},
    "promotion_review_ref":{"type":"string","minLength":1},
    "source_canary_grant_id":{"type":"string","minLength":1},
    "source_canary_grant_version":{"type":"string","minLength":1},
    "source_canary_grant_hash":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "valid_from":{"type":"string","format":"date-time"},
    "expires_at":{"type":"string","format":"date-time"},
    "allowed_risk_classes":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["RISK0","RISK1"]}},
    "allowed_action_types":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "allowed_hosts":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^[A-Za-z0-9.-]+$"}},
    "executor_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "max_executions_total":{"type":"integer","minimum":1},
    "max_executions_per_window":{"type":"integer","minimum":1},
    "window_seconds":{"type":"integer","minimum":60},
    "max_cost_minor_total":{"type":"integer","minimum":0},
    "currency":{"type":"string","pattern":"^[A-Z]{3}$"},
    "max_pending_outcomes":{"type":"integer","minimum":1},
    "max_consecutive_failures":{"type":"integer","minimum":1},
    "max_outcome_age_seconds":{"type":"integer","minimum":60},
    "max_health_snapshot_age_seconds":{"type":"integer","minimum":60},
    "kill_switch_required":{"const":true},
    "correlation_id":{"type":"string","minLength":1},
    "hash_version":{"const":"go-json-v1"},
    "lease_hash":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
