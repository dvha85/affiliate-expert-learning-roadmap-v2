{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "production-activation-record.schema.json",
  "title": "ProductionActivationRecord",
  "type": "object",
  "required": ["lease_id", "lease_version", "lease_hash", "activated_at"],
  "properties": {
    "lease_id": {"type": "string", "minLength": 1},
    "lease_version": {"type": "string", "minLength": 1},
    "lease_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "activated_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
