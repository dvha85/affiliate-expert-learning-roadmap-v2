{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "action-intent.schema.json",
  "title": "ActionIntent",
  "type": "object",
  "required": [
    "intent_id", "decision_id", "evidence_ids", "action_type", "target", "parameters",
    "proposed_by", "created_at", "expires_at", "correlation_id", "idempotency_key",
    "intent_hash", "intent_mode", "execution_authorized"
  ],
  "properties": {
    "intent_id": {"type": "string", "minLength": 1},
    "decision_id": {"type": "string", "minLength": 1},
    "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "action_type": {"type": "string", "minLength": 1},
    "target": {"type": "string", "minLength": 1},
    "parameters": {"type": "object"},
    "proposed_by": {"enum": ["human", "agent"]},
    "proposal_ref": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "correlation_id": {"type": "string", "minLength": 1},
    "idempotency_key": {"type": "string", "minLength": 1},
    "intent_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "intent_mode": {"const": "PROPOSAL_ONLY"},
    "execution_authorized": {"const": false}
  },
  "allOf": [
    {
      "if": {"properties": {"proposed_by": {"const": "agent"}}, "required": ["proposed_by"]},
      "then": {"required": ["proposal_ref"]}
    }
  ],
  "additionalProperties": false
}
