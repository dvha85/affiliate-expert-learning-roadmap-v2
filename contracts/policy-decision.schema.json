{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "policy-decision.schema.json",
  "title": "PolicyDecision",
  "type": "object",
  "required": ["policy_version", "action_id", "decision", "risk_class", "reason"],
  "properties": {
    "policy_version": {"type": "string", "minLength": 1},
    "action_id": {"type": "string", "minLength": 1},
    "decision": {"enum": ["ALLOW", "DENY", "WAIT", "GET_MORE_DATA", "HUMAN_REVIEW"]},
    "risk_class": {"enum": ["RISK0", "RISK1", "RISK2"]},
    "reason": {"type": "string", "minLength": 1},
    "approval_required": {"type": "boolean"},
    "policy_checked_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": true
}
