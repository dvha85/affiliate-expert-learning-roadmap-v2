{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "decision-packet.schema.json",
  "title": "DecisionPacket",
  "type": "object",
  "required": ["decision_id", "question", "state", "reason", "supported_facts", "assumptions", "unknowns", "missing_evidence", "next_measurement"],
  "properties": {
    "decision_id": {"type": "string", "minLength": 1},
    "question": {"type": "string", "minLength": 1},
    "state": {"enum": ["RANK_SCENARIO", "GET_MORE_DATA", "HUMAN_REVIEW", "WAIT"]},
    "reason": {"type": "string", "minLength": 1},
    "supported_facts": {"type": "array", "items": {"type": "string"}},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "unknowns": {"type": "array", "items": {"type": "string"}},
    "missing_evidence": {"type": "array", "items": {"type": "string"}},
    "next_measurement": {"type": "string"},
    "action": {"type": ["null", "object"]}
  },
  "additionalProperties": true
}
