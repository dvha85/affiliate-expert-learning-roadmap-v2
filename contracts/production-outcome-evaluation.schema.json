{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"production-outcome-evaluation.schema.json",
  "title":"ProductionOutcomeEvaluation",
  "type":"object",
  "required":["evaluation_id","lease_id","lease_version","lease_hash","execution_id","outcome_id","evaluated_at","result","evidence_ids","limitations","source_profile"],
  "properties":{
    "evaluation_id":{"type":"string","minLength":1},
    "lease_id":{"type":"string","minLength":1},
    "lease_version":{"type":"string","minLength":1},
    "lease_hash":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "execution_id":{"type":"string","minLength":1},
    "outcome_id":{"type":"string","minLength":1},
    "evaluated_at":{"type":"string","format":"date-time"},
    "result":{"const":"FIXTURE_NO_SIDE_EFFECT"},
    "evidence_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "limitations":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "source_profile":{"const":"OFFLINE_FIXTURE"}
  },
  "additionalProperties":false
}
