{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"tool-registry.schema.json",
  "title":"ToolRegistry",
  "type":"array",
  "minItems":1,
  "items":{
    "type":"object",
    "required":["name","read_only","allowed_methods","allowed_hosts"],
    "properties":{
      "name":{"type":"string","minLength":1},
      "read_only":{"const":true},
      "allowed_methods":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["GET","HEAD"]}},
      "allowed_hosts":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}}
    },
    "additionalProperties":false
  }
}
