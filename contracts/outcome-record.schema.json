{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"outcome-record.schema.json",
  "title":"OutcomeRecord",
  "type":"object",
  "required":["outcome_id","action_id","observed_at","status","metrics","source_ref"],
  "properties":{
    "outcome_id":{"type":"string","minLength":1},"action_id":{"type":"string","minLength":1},"observed_at":{"type":"string","format":"date-time"},
    "status":{"enum":["PENDING","VALID","CANCELLED","REFUNDED","PAID","NO_OBSERVED_OUTCOME"]},"metrics":{"type":"object","additionalProperties":{"type":"number","minimum":0}},"source_ref":{"type":"string","minLength":1}
  },"additionalProperties":false
}
