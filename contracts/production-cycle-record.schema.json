{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"production-cycle-record.schema.json",
  "title":"ProductionCycleRecord",
  "type":"object",
  "required":["cycle_id","lease_id","lease_version","lease_hash","observation_ids","decision_id","intent_id","intent_hash","gate_id","authorization_id","execution_id","outcome_id","evaluation_id","status","opened_at","closed_at","correlation_id"],
  "properties":{
    "cycle_id":{"type":"string","minLength":1},
    "lease_id":{"type":"string","minLength":1},
    "lease_version":{"type":"string","minLength":1},
    "lease_hash":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "observation_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "decision_id":{"type":"string","minLength":1},
    "intent_id":{"type":"string","minLength":1},
    "intent_hash":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "gate_id":{"type":"string","minLength":1},
    "authorization_id":{"type":"string","minLength":1},
    "execution_id":{"type":"string","minLength":1},
    "outcome_id":{"type":"string","minLength":1},
    "evaluation_id":{"type":"string","minLength":1},
    "improvement_proposal_id":{"type":"string","minLength":1},
    "review_id":{"type":"string","minLength":1},
    "status":{"enum":["CLOSED","REVIEW_PENDING","STOPPED"]},
    "opened_at":{"type":"string","format":"date-time"},
    "closed_at":{"type":"string","format":"date-time"},
    "correlation_id":{"type":"string","minLength":1}
  },
  "additionalProperties":false
}
