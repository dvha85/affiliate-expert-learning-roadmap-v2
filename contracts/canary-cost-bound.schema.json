{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "canary-cost-bound.schema.json",
  "title": "CanaryCostBound",
  "type": "object",
  "required": ["cost_bound_id","intent_id","intent_hash","max_cost_minor","currency","source_ref","observed_at","expires_at","correlation_id","hash_version","cost_bound_hash"],
  "properties": {
    "cost_bound_id": {"type":"string","minLength":1},
    "intent_id": {"type":"string","minLength":1},
    "intent_hash": {"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "max_cost_minor": {"type":"integer","minimum":0},
    "currency": {"type":"string","pattern":"^[A-Z]{3}$"},
    "source_ref": {"type":"string","minLength":1},
    "observed_at": {"type":"string","format":"date-time"},
    "expires_at": {"type":"string","format":"date-time"},
    "correlation_id": {"type":"string","minLength":1},
    "hash_version": {"const":"go-json-v1"},
    "cost_bound_hash": {"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
