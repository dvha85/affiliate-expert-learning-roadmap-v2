{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"evaluation-record.schema.json",
  "title":"EvaluationRecord",
  "type":"object",
  "required":["evaluation_id","decision_id","action_id","outcome_ids","evaluated_at","result","evidence_ids","limitations"],
  "properties":{
    "evaluation_id":{"type":"string","minLength":1},
    "decision_id":{"type":"string","minLength":1},
    "action_id":{"type":"string","minLength":1},
    "outcome_ids":{"type":"array","minItems":1,"items":{"type":"string","minLength":1},"uniqueItems":true},
    "evaluated_at":{"type":"string","format":"date-time"},
    "result":{"enum":["SUPPORTED","NOT_SUPPORTED","INCONCLUSIVE","NEEDS_MORE_DATA"]},
    "evidence_ids":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},
    "limitations":{"type":"array","items":{"type":"string"}},
    "notes":{"type":"string"}
  },
  "additionalProperties":false
}
