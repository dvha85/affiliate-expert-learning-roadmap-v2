{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "canary-gate-decision.schema.json",
  "title": "CanaryGateDecision",
  "type": "object",
  "required": ["gate_id","grant_id","grant_version","grant_hash","intent_id","intent_hash","policy_version","risk_class","cost_bound_id","cost_bound_hash","cost_bound_minor","decision","reason","evaluated_at","executions_total_before","executions_in_window_before","cost_minor_total_before","pending_outcomes_before","per_action_approval_required","execution_authorized"],
  "properties": {
    "gate_id": {"type":"string","minLength":1},
    "grant_id": {"type":"string","minLength":1},
    "grant_version": {"type":"string","minLength":1},
    "grant_hash": {"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "intent_id": {"type":"string","minLength":1},
    "intent_hash": {"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "policy_version": {"type":"string","minLength":1},
    "risk_class": {"enum":["RISK0","RISK1","RISK2"]},
    "cost_bound_id": {"type":"string","minLength":1},
    "cost_bound_hash": {"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "cost_bound_minor": {"type":"integer","minimum":0},
    "decision": {"enum":["ALLOW_CANARY","REQUIRE_APPROVAL","DENY","WAIT"]},
    "reason": {"type":"string","minLength":1},
    "evaluated_at": {"type":"string","format":"date-time"},
    "executions_total_before": {"type":"integer","minimum":0},
    "executions_in_window_before": {"type":"integer","minimum":0},
    "cost_minor_total_before": {"type":"integer","minimum":0},
    "pending_outcomes_before": {"type":"integer","minimum":0},
    "per_action_approval_required": {"type":"boolean"},
    "execution_authorized": {"const":false}
  },
  "allOf": [
    {"if":{"properties":{"decision":{"const":"REQUIRE_APPROVAL"}},"required":["decision"]},"then":{"properties":{"per_action_approval_required":{"const":true}}}},
    {"if":{"properties":{"decision":{"const":"ALLOW_CANARY"}},"required":["decision"]},"then":{"properties":{"per_action_approval_required":{"const":false}}}}
  ],
  "additionalProperties": false
}
