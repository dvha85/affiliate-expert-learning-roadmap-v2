{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"production-lease-approval.schema.json",
  "title":"ProductionLeaseApproval",
  "type":"object",
  "required":["approval_id","lease_id","lease_version","lease_hash","source_canary_grant_hash","source_e5_refs","validated_risk_classes","reviewed_by","reviewer_id","reviewed_at","decision"],
  "properties":{
    "approval_id":{"type":"string","minLength":1},
    "lease_id":{"type":"string","minLength":1},
    "lease_version":{"type":"string","minLength":1},
    "lease_hash":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "source_canary_grant_hash":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "source_e5_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "validated_risk_classes":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["RISK0","RISK1"]}},
    "reviewed_by":{"const":"human"},
    "reviewer_id":{"type":"string","minLength":1},
    "reviewed_at":{"type":"string","format":"date-time"},
    "decision":{"const":"APPROVE_PRODUCTION_LEASE"}
  },
  "additionalProperties":false
}
